# From the Discord Developer Portal > your app > Bot > Reset Token.
DISCORD_TOKEN=

# Comma-separated server IDs the bot may stay in. Any other server that adds
# it is left at once. Leave empty to allow any server.
ALLOWED_GUILD_IDS=

# Only needed on a cloud host if YouTube asks it to sign in. Either a path to
# a cookies.txt, or that file's contents as base64.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_B64=

# Optional: where the tools are, if not on PATH.
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg

# Optional: leave after this many minutes with nothing playing (default 5).
# IDLE_MINUTES=5
